@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.IssuesModel
@using TeamManager.Web.Pages
@{
    var visibleColumns = IssuesModel.ColumnLabels.Where(column => Model.VisibleColumns.Contains(column.Key)).ToList();
    var canSelect = Model.Items.Any(item => Model.CanEdit.Contains(item.ProjectId));
}
<p class="muted">@Text["PROJEKTI / ZADACI"]</p><h1>@Text["Projektni zadaci"]</h1><p>@Text["Prikazani su projekti za koje imaš ovlast pregleda zadataka."]</p>
<div class="card"><form method="get" class="grid"><label>@Text["Projekt"]<select asp-for="ProjectId"><option value="">@Text["Svi dostupni projekti"]</option>@foreach(var p in Model.Projects){<option value="@p.Id">@p.Name</option>}</select></label><label>@Text["Status"]<select asp-for="Status"><option value="">@Text["Svi statusi"]</option>@foreach(var s in Model.Statuses){<option>@s</option>}</select></label><label>@Text["Pretraga"]<input asp-for="Query" maxlength="200"></label><label>@Text["Sortiranje"]
    <select asp-for="SortOrder">
        @foreach(var sort in IssuesModel.SortLabels){<option value="@sort.Key">@Text[sort.Value]</option>}
    </select>
</label>
<label>@Text["Grupiranje"]
    <select asp-for="GroupBy">
        <option value="">@Text["Bez grupiranja"]</option>
        @foreach(var group in IssuesModel.GroupLabels){<option value="@group.Key">@Text[group.Value]</option>}
    </select>
</label>
<fieldset>
    <legend>@Text["Dodatni stupci"]</legend>
    <input type="hidden" name="Column" value="title">
    @foreach(var column in IssuesModel.ColumnLabels)
    {
        <label><input style="width:auto" type="checkbox" name="Column" value="@column.Key" checked="@Model.VisibleColumns.Contains(column.Key)"> @(column.Key == "id" ? Text["Broj zadatka"].Value : Text[column.Value].Value)</label>
    }
</fieldset>
<div><button>@Text["Primijeni"]</button> <button name="handler" value="Csv" data-download>@Text["Izvezi CSV"]</button> <a href="/Issues">@Text["Očisti"]</a></div></form></div>
@if(Model.ProjectId is int selectedProject){var selected=Model.Projects.Find(p=>p.Id==selectedProject); if(selected is not null){<p><a asp-page="/Project" asp-route-id="@selectedProject">@selected.Name</a> @if(Model.CanCreate.Contains(selectedProject)){<a class="button" asp-page="/Issue" asp-route-projectId="@selectedProject" asp-route-returnUrl="@Model.CurrentListUrl">@Text["Novi zadatak"]</a>}</p>}}
else{<p class="muted">@Text["Za novi zadatak odaberi projekt u filtru."]</p>}
@if(TempData["Notice"] is string notice){<p class="notice">@Text[notice]</p>}
<div asp-validation-summary="All"></div>
<div class="card table">
    @if (Model.Items.Count == 0)
    {
        <p>@Text["Nema zadataka za odabrane filtre."]</p>
    }
    else
    {
        <p>@Text["Ukupno zadataka"]: @Model.TotalCount</p>
        @foreach (var group in Model.Groups)
        {
            <table scroll-label="@Text["Projektni zadaci"]">
                @if (Model.GroupBy is not null)
                {
                    <caption>@group.Key · @Text["{0} zadataka", group.Count()]</caption>
                }
                <thead><tr>
                    @if (canSelect) { <th>@Text["Odabir"]</th> }
                    <th>@Text["Zadatak"]</th>
                    @foreach (var column in visibleColumns) { <th>@Text[column.Value]</th> }
                </tr></thead>
                <tbody>
                    @foreach (var item in group)
                    {
                        <tr>
                            @if (canSelect)
                            {
                                <td>
                                    @if (Model.CanEdit.Contains(item.ProjectId))
                                    {
                                        <input form="bulk-edit" type="checkbox" name="selection" value="@item.Id:@item.Revision" aria-label="@Text["Odaberi zadatak {0}", item.Id]">
                                    }
                                </td>
                            }
                            <td><a asp-page="/Issue" asp-route-id="@item.Id" asp-route-returnUrl="@Model.CurrentListUrl">@item.Title</a></td>
                            @foreach (var column in visibleColumns) { <td>@(column.Key == "assignee" && item.Assignee is null ? Text["Nije dodijeljen"].Value : IssuesModel.ColumnText(item, column.Key))</td> }
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>@if(Model.PageCount>1){<div class="pagination" role="navigation" aria-label="@Text["Stranice zadataka"]">@if(Model.PageNumber>1){<a href="@Model.PageUrl(Model.PageNumber-1)">@Text["Prethodna stranica"]</a>} <span>@Text["Stranica {0} od {1}",Model.PageNumber,Model.PageCount]</span> @if(Model.PageNumber<Model.PageCount){<a href="@Model.PageUrl(Model.PageNumber+1)">@Text["Sljedeća stranica"]</a>}</div>}
<section class="card">
    <h2>@Text["Moji spremljeni upiti"]</h2>
    @foreach (var saved in Model.SavedQueries)
    {
        <div class="actions">
            <a asp-page-handler="Saved" asp-route-id="@saved.Id">@saved.Name</a>
            <form method="post" asp-route-pageNumber="@Model.PageNumber" asp-page-handler="DeleteQuery" asp-route-id="@saved.Id" asp-route-projectId="@Model.ProjectId" asp-route-status="@Model.Status" asp-route-query="@Model.Query" asp-route-sortOrder="@Model.SortOrder" asp-route-groupBy="@Model.GroupBy" asp-route-columns="@Model.Columns">
                <button aria-label="@Text["Ukloni upit {0}", saved.Name]">@Text["Ukloni"]</button>
            </form>
        </div>
    }
    <form method="post" asp-route-pageNumber="@Model.PageNumber" asp-page-handler="SaveQuery" asp-route-projectId="@Model.ProjectId" asp-route-status="@Model.Status" asp-route-query="@Model.Query" asp-route-sortOrder="@Model.SortOrder" asp-route-groupBy="@Model.GroupBy" asp-route-columns="@Model.Columns">
        <label>@Text["Naziv upita"]<input name="name" maxlength="80" required></label>
        <button>@Text["Spremi filtre i prikaz"]</button>
    </form>
</section>
@if (canSelect)
{
    <form id="bulk-edit" method="post" asp-page-handler="Bulk" asp-route-projectId="@Model.ProjectId" asp-route-status="@Model.Status" asp-route-query="@Model.Query" asp-route-sortOrder="@Model.SortOrder" asp-route-groupBy="@Model.GroupBy" asp-route-columns="@Model.Columns" class="card">
        <h2>@Text["Skupno uređivanje"]</h2>
        <p>@Text["Označi do 100 zadataka na popisu."]</p>
        <label>@Text["Status"]<select name="bulkStatus"><option value="">@Text["Zadrži postojeći"]</option>@foreach(var status in Model.Statuses){<option>@status</option>}</select></label>
        <label>@Text["Prioritet"]<select name="bulkPriority"><option value="">@Text["Zadrži postojeći"]</option>@foreach(var priority in Model.Priorities){<option>@priority</option>}</select></label>
        <button>@Text["Spremi odabrane zadatke"]</button>
    </form>
}
