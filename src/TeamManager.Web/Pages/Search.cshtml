@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.SearchModel
<h1>@Text["Pretraga"]</h1>
<section class="card">
    <form method="get" class="grid">
        <div asp-validation-summary="All"></div>
        <label>@Text["Pojam"]<input asp-for="Query" type="search" maxlength="200" required></label>
        <label>@Text["Modul"]
            <select asp-for="Module">
                <option value="">@Text["Svi moduli"]</option>
                @foreach(var module in TeamManager.Web.Pages.SearchModel.ModuleLabels){<option value="@module.Key">@Text[module.Value]</option>}
            </select>
        </label>
        <div><button>@Text["Pretraži"]</button></div>
    </form>
</section>

@if (Model.Searched)
{
    @if (Model.Results.Values.All(items => items.Count == 0))
    {
        <p>@Text["Nema rezultata za odabrani pojam."]</p>
        @if(Model.PageNumber>1){<p><a href="@Url.Page("/Search",new{Model.Query,Model.Module,PageNumber=Model.PageNumber-1})">@Text["Prethodna stranica"]</a> · <a href="@Url.Page("/Search",new{Model.Query,Model.Module,PageNumber=1})">@Text["Prva stranica"]</a></p>}
    }
    else
    {
        @foreach (var group in Model.Results.Where(group => group.Value.Count > 0))
        {
            <section class="card">
                <h2>@Text[group.Key]</h2>
                <ul>
                    @foreach (var item in group.Value)
                    {
                        <li><a href="@item.Url">@item.Title</a>@if (item.Detail.Length > 0) { <span> · @item.Detail</span> }</li>
                    }
                </ul>
                @if (Model.More.Contains(group.Key))
                {
                    <p><a href="@Model.ResultsUrl(group.Key,Model.PageNumber+1)">@Text["Sljedeća stranica"]</a></p>
                }
                @if(Model.PageNumber>1){<p><a href="@Model.ResultsUrl(group.Key,Model.PageNumber-1)">@Text["Prethodna stranica"]</a></p>}
            </section>
        }
    }
}
