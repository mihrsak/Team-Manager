@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.WorkflowModel
<h1>@Text["Šifrarnici i tijek rada"]</h1><p>@Text["Prijelazi definiraju koje promjene statusa dopušta rola za pojedini tip zadatka. Puna administracija može izvršiti svaki prijelaz. Novi zadaci počinju statusom Novo."]</p><div asp-validation-summary="All"></div>
<section class="card"><h2>@Text["Poredak i aktivnost šifrarnika"]</h2><p>@Text["Manji broj prikazuje se prije. Neaktivne vrijednosti ostaju na starim zadacima, ali nisu dostupne za novu dodjelu. Stanja poput Blokirano i Otkazano pripadaju statusima, a prioritet označava hitnost."]</p>
@foreach(var entry in Model.Catalog)
{
    var draft=Model.CatalogDraft is {} submitted&&submitted.Kind==entry.Kind&&submitted.Name==entry.Name?submitted:null;
    var active=draft?.Active??(entry.IsActive?"true":"false");
    <form method="post" asp-page-handler="Catalog" data-unsaved-draft="@(draft is not null?"true":null)">
        <input type="hidden" name="kind" value="@entry.Kind"><input type="hidden" name="name" value="@entry.Name">
        <strong>@entry.Name</strong> · @Text[entry.Kind=="priority"?"Prioritet":entry.Kind=="status"?"Status":"Tip zadatka"]
        <label>@Text["Poredak"]<input type="number" name="order" min="0" max="100000" value="@(draft?.Order??entry.SortOrder.ToString(System.Globalization.CultureInfo.InvariantCulture))" required></label>
        <label>@Text["Aktivnost vrijednosti"]<select name="active">
            @if(active is not ("true" or "false")){<option value="@active" selected>@Text["Nevaljan odabir — odaberi ponovno"]</option>}
            <option value="true" selected="@(active=="true")">@Text["Aktivno"]</option><option value="false" selected="@(active=="false")">@Text["Neaktivno"]</option>
        </select></label><button>@Text["Spremi"]</button>
    </form>
}
</section>
<div class="grid"><section class="card"><h2>@Text["Novi šifrarnik"]</h2>
<form method="post" asp-page-handler="Value" data-unsaved-draft="@(Model.ValueDraft is not null?"true":null)">
    <label>@Text["Vrsta"]<select name="kind" data-lookup-kind>
        @if(Model.ValueDraft is {} valueDraft&&valueDraft.Kind is not ("type" or "status" or "priority")){<option value="@valueDraft.Kind" selected>@Text["Nevaljan odabir — odaberi ponovno"]</option>}
        <option value="type" selected="@(Model.ValueDraft is null||Model.ValueDraft.Kind=="type")">@Text["Tip zadatka"]</option>
        <option value="status" selected="@(Model.ValueDraft?.Kind=="status")">@Text["Status"]</option>
        <option value="priority" selected="@(Model.ValueDraft?.Kind=="priority")">@Text["Prioritet"]</option>
    </select></label>
    <label>@Text["Naziv"]<input name="name" value="@Model.ValueDraft?.Name" required maxlength="50" aria-describedby="lookup-name-limit"><small id="lookup-name-limit">@Text["Tip: 50 znakova; status: 30; prioritet: 20."]</small></label>
    <label><input type="checkbox" name="closed" value="true" checked="@(Model.ValueDraft?.Closed==true)" style="display:inline;width:auto"> @Text["Zatvoreni status"]</label><button>@Text["Dodaj vrijednost"]</button>
</form><p>@Text["Tipovi"]: @string.Join(", ",Model.Types)</p><p>@Text["Statusi"]: @string.Join(", ",Model.Statuses)</p><p>@Text["Prioriteti"]: @string.Join(", ",Model.Priorities)</p></section>
<section class="card"><h2>@Text["Dopušteni prijelaz"]</h2>
@{var transitionDraft=Model.TransitionDraft is {Remove:false}?Model.TransitionDraft:null;}
<form method="post" asp-page-handler="Transition" data-unsaved-draft="@(transitionDraft is not null?"true":null)">
    <label>@Text["Rola"]<select name="role">
        @if(transitionDraft is not null&&!Model.Roles.Any(r=>r.Name==transitionDraft.Role)){<option value="@transitionDraft.Role" selected>@Text["Nevaljan odabir — odaberi ponovno"]</option>}
        @foreach(var r in Model.Roles){<option selected="@(transitionDraft?.Role==r.Name)">@r.Name</option>}
    </select></label>
    <label>@Text["Tip"]<select name="type">
        @if(transitionDraft is not null&&!Model.Types.Contains(transitionDraft.Type)){<option value="@transitionDraft.Type" selected>@Text["Nevaljan odabir — odaberi ponovno"]</option>}
        @foreach(var t in Model.Types){<option selected="@(transitionDraft?.Type==t)">@t</option>}
    </select></label>
    <label>@Text["Iz statusa"]<select name="from">
        @if(transitionDraft is not null&&!Model.Statuses.Contains(transitionDraft.From)){<option value="@transitionDraft.From" selected>@Text["Nevaljan odabir — odaberi ponovno"]</option>}
        @foreach(var s in Model.Statuses){<option selected="@(transitionDraft?.From==s)">@s</option>}
    </select></label>
    <label>@Text["U status"]<select name="to">
        @if(transitionDraft is not null&&!Model.Statuses.Contains(transitionDraft.To)){<option value="@transitionDraft.To" selected>@Text["Nevaljan odabir — odaberi ponovno"]</option>}
        @foreach(var s in Model.Statuses){<option selected="@(transitionDraft?.To==s)">@s</option>}
    </select></label><button>@Text["Dodaj prijelaz"]</button>
</form></section></div>
<section class="card table"><h2>@Text["Konfigurirani prijelazi"]</h2><table><thead><tr><th>@Text["Rola"]</th><th>@Text["Tip"]</th><th>@Text["Iz"]</th><th>@Text["U"]</th><th></th></tr></thead><tbody>
@foreach(var t in Model.Transitions)
{
    var draft=Model.TransitionDraft is {Remove:true} requested&&requested.Role==t.Role&&requested.Type==t.Type&&requested.From==t.From&&requested.To==t.To;
    <tr><td>@t.Role</td><td>@t.Type</td><td>@t.From</td><td>@t.To</td><td><form method="post" asp-page-handler="Transition" data-unsaved-draft="@(draft?"true":null)"><input type="hidden" name="role" value="@t.Role"><input type="hidden" name="type" value="@t.Type"><input type="hidden" name="from" value="@t.From"><input type="hidden" name="to" value="@t.To"><button name="remove" value="true">@Text["Ukloni"]</button></form></td></tr>
}
</tbody></table></section>
