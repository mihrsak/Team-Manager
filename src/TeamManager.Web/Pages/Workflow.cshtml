@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.WorkflowModel
<h1>@Text["Šifrarnici i tijek rada"]</h1><p>@Text["Prijelazi definiraju koje promjene statusa dopušta rola za pojedini tip zadatka. Puna administracija može izvršiti svaki prijelaz. Novi zadaci počinju statusom Novo."]</p><div asp-validation-summary="All"></div>
<div class="grid"><section class="card"><h2>@Text["Novi šifrarnik"]</h2><form method="post" asp-page-handler="Value"><label>@Text["Vrsta"]<select name="kind"><option value="type">@Text["Tip zadatka"]</option><option value="status">@Text["Status"]</option><option value="priority">@Text["Prioritet"]</option></select></label><label>@Text["Naziv"]<input name="name" required maxlength="50"></label><label><input type="checkbox" name="closed" value="true" style="display:inline;width:auto"> @Text["Zatvoreni status"]</label><button>@Text["Dodaj vrijednost"]</button></form><p>@Text["Tipovi"]: @string.Join(", ",Model.Types)</p><p>@Text["Statusi"]: @string.Join(", ",Model.Statuses)</p><p>@Text["Prioriteti"]: @string.Join(", ",Model.Priorities)</p></section>
<section class="card"><h2>@Text["Dopušteni prijelaz"]</h2><form method="post" asp-page-handler="Transition"><label>@Text["Rola"]<select name="role">@foreach(var r in Model.Roles){<option>@r.Name</option>}</select></label><label>@Text["Tip"]<select name="type">@foreach(var t in Model.Types){<option>@t</option>}</select></label><label>@Text["Iz statusa"]<select name="from">@foreach(var s in Model.Statuses){<option>@s</option>}</select></label><label>@Text["U status"]<select name="to">@foreach(var s in Model.Statuses){<option>@s</option>}</select></label><button>@Text["Dodaj prijelaz"]</button></form></section></div>
<section class="card table"><h2>@Text["Konfigurirani prijelazi"]</h2><table><thead><tr><th>@Text["Rola"]</th><th>@Text["Tip"]</th><th>@Text["Iz"]</th><th>@Text["U"]</th><th></th></tr></thead><tbody>@foreach(var t in Model.Transitions){<tr><td>@t.Role</td><td>@t.Type</td><td>@t.From</td><td>@t.To</td><td><form method="post" asp-page-handler="Transition"><input type="hidden" name="role" value="@t.Role"><input type="hidden" name="type" value="@t.Type"><input type="hidden" name="from" value="@t.From"><input type="hidden" name="to" value="@t.To"><button name="remove" value="true">@Text["Ukloni"]</button></form></td></tr>}</tbody></table></section>
