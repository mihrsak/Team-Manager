@page
@model TeamManager.Web.Pages.WorkflowModel
<h1>Šifrarnici i tijek rada</h1><p>Prijelazi definiraju koje promjene statusa dopušta rola za pojedini tip zadatka. Puna administracija može izvršiti svaki prijelaz. Novi zadaci počinju statusom Novo.</p><div asp-validation-summary="All"></div>
<div class="grid"><section class="card"><h2>Novi šifrarnik</h2><form method="post" asp-page-handler="Value"><label>Vrsta<select name="kind"><option value="type">Tip zadatka</option><option value="status">Status</option><option value="priority">Prioritet</option></select></label><label>Naziv<input name="name" required maxlength="30"></label><label><input type="checkbox" name="closed" value="true" style="display:inline;width:auto"> Zatvoreni status</label><button>Dodaj vrijednost</button></form><p>Tipovi: @string.Join(", ",Model.Types)</p><p>Statusi: @string.Join(", ",Model.Statuses)</p><p>Prioriteti: @string.Join(", ",Model.Priorities)</p></section>
<section class="card"><h2>Dopušteni prijelaz</h2><form method="post" asp-page-handler="Transition"><label>Rola<select name="role">@foreach(var r in Model.Roles){<option>@r.Name</option>}</select></label><label>Tip<select name="type">@foreach(var t in Model.Types){<option>@t</option>}</select></label><label>Iz statusa<select name="from">@foreach(var s in Model.Statuses){<option>@s</option>}</select></label><label>U status<select name="to">@foreach(var s in Model.Statuses){<option>@s</option>}</select></label><button>Dodaj prijelaz</button></form></section></div>
<section class="card table"><h2>Konfigurirani prijelazi</h2><table><thead><tr><th>Rola</th><th>Tip</th><th>Iz</th><th>U</th><th></th></tr></thead><tbody>@foreach(var t in Model.Transitions){<tr><td>@t.Role</td><td>@t.Type</td><td>@t.From</td><td>@t.To</td><td><form method="post" asp-page-handler="Transition"><input type="hidden" name="role" value="@t.Role"><input type="hidden" name="type" value="@t.Type"><input type="hidden" name="from" value="@t.From"><input type="hidden" name="to" value="@t.To"><button name="remove" value="true">Ukloni</button></form></td></tr>}</tbody></table></section>
