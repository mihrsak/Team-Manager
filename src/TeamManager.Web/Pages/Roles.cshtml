@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.RolesModel
<h1>@Text["Role i ovlasti"]</h1>
@if (User.IsInRole("*")) { <p><a asp-page="/AdministrationAudit">@Text["Revizijski zapis"]</a></p> }<p>@Text["Kreiraj rolu i odaberi prava koja daje. Globalne role vrijede u cijeloj aplikaciji; role članstva samo u dodijeljenom timu ili projektu."]</p><div asp-validation-summary="All"></div>
@if(User.IsInRole("*")){<p><a asp-page="/Groups">@Text["Grupe korisnika"]</a> · <a asp-page="/CustomFields">@Text["Prilagodljiva polja"]</a></p>}
<div class="grid">@foreach(var role in Model.Roles){<section class="card"><h2>@role.Name</h2><form method="post"><input type="hidden" name="name" value="@role.Name"><label>@Text["Opis"]<input name="description" value="@role.Description" maxlength="200"></label>
@foreach(var permission in Permissions.Catalog){<label><input style="display:inline;width:auto" type="checkbox" name="rights" value="@permission.Key" checked="@role.Permissions.Contains(permission.Key)"> @Text[permission.Value]</label>}
<button>@Text["Spremi ovlasti"]</button></form></section>}
<section class="card"><h2>@Text["Nova rola"]</h2><form method="post"><input type="hidden" name="create" value="true"><label>@Text["Naziv"]<input name="name" required maxlength="30"></label><label>@Text["Opis"]<input name="description" maxlength="200"></label>@foreach(var permission in Permissions.Catalog){<label><input style="display:inline;width:auto" type="checkbox" name="rights" value="@permission.Key"> @Text[permission.Value]</label>}<button>@Text["Kreiraj rolu"]</button></form></section></div>
<p class="muted">@Text["Prava za zadatke, dokumente i ostale module dodavat ćemo kada ti moduli budu implementirani. Posljednjem administratoru nije moguće ukloniti punu administraciju."]</p>
