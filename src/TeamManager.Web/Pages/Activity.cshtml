@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.ActivityModel
@using TeamManager.Web.Pages
<h1>@Text["Aktivnosti"]</h1>
<section class="card">
    <form method="get" class="actions">
        <label>@Text["Projekt"]
            <select asp-for="ProjectId">
                <option value="">@Text["Svi dostupni projekti"]</option>
                @foreach (var project in Model.Projects)
                {
                    <option value="@project.Id">@project.Name</option>
                }
            </select>
        </label>
        <button>@Text["Prikaži"]</button>
    </form>
    <p>
        <a asp-page-handler="Atom" asp-route-projectId="@Model.ProjectId">Atom</a> ·
        <a asp-page-handler="Rss" asp-route-projectId="@Model.ProjectId">RSS</a>
    </p>
</section>

@if (Model.Entries.Count == 0)
{
    <p>@Text["Nema aktivnosti u odabranim projektima."]</p>
}
else
{
    <div class="card table">
        <table scroll-label="@Text["Aktivnosti"]">
            <caption>@Text["Posljednjih {0} aktivnosti", Model.Entries.Count]</caption>
            <thead><tr><th>@Text["Vrijeme (UTC)"]</th><th>@Text["Aktivnost"]</th><th>@Text["Zadatak"]</th><th>@Text["Projekt"]</th><th>@Text["Korisnik"]</th></tr></thead>
            <tbody>
                @foreach (var entry in Model.Entries)
                {
                    <tr id="activity-@entry.Id">
                        <td><time datetime="@entry.At.ToString("O")">@entry.At.ToString("g")</time></td>
                        <td>@Text[ActivityModel.KindLabel(entry.Kind)]</td>
                        <td><a asp-page="/Issue" asp-route-id="@entry.IssueId" asp-route-returnUrl="@Model.ReturnTo(entry.Id)">@entry.Title</a></td>
                        <td>@entry.Project</td><td>@entry.Author</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
