@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.UsersModel
<p class="muted">@Text["ORGANIZACIJA / KORISNICI"]</p><h1>@Text["Korisnici"]</h1><p>@Text["Brojevi radnika, funkcije i organizacijske jedinice."]</p>
@if (User.IsInRole("*"))
{
    <p><a asp-page="/RegistrationRequests">@Text["Zahtjevi za registraciju"]</a></p>
}
<div class="card table"><table><thead><tr><th>@Text["Broj radnika"]</th><th>@Text["Ime i prezime"]</th><th>@Text["Funkcija"]</th><th>@Text["Organizacijska jedinica"]</th><th></th></tr></thead><tbody>
@foreach(var entry in Model.Entries){<tr><td>@entry.User.EmployeeNumber</td><td>@entry.User.DisplayName @if (!entry.User.IsActive) { <span class="badge">@Text["Deaktiviran"]</span> }</td><td>@entry.User.JobTitle</td><td>@entry.Unit</td><td><a asp-page="/Profile" asp-route-id="@entry.User.Id">@Text["Profil"]</a></td></tr>}
</tbody></table></div>
<div asp-validation-summary="All"></div><div class="grid">
@if(User.IsInRole("users.manage")){
<section class="card"><h2>@Text["Novi korisnik"]</h2><form method="post" asp-page-handler="Create">
<label>@Text["Broj radnika"]<input name="employee" required maxlength="30" pattern="[A-Za-z0-9._-]+"></label><label>@Text["Ime i prezime"]<input name="name" required maxlength="100"></label><label>@Text["Funkcija"]<input name="job" maxlength="100"></label>
<label>@Text["Organizacijska jedinica"]<select name="unit"><option value="">@Text["Nije dodijeljena"]</option>@foreach(var unit in Model.Units){<option value="@unit.Id">@unit.Name</option>}</select></label>
<label>@Text["Početna lozinka"]<input name="password" type="password" required minlength="7" maxlength="200" autocomplete="new-password"></label><button>@Text["Dodaj korisnika"]</button></form></section>
}
@if(User.IsInRole("organization.manage")){<section class="card"><h2>@Text["Organizacija, timovi i projekti"]</h2><p class="muted">@Text["Nakon kreiranja, članstvo i ulogu dodijeli na profilu korisnika."]</p><form method="post" asp-page-handler="Scope">
<label>@Text["Vrsta"]<select name="kind"><option value="unit">@Text["Organizacijska jedinica"]</option><option value="team">@Text["Tim"]</option><option value="project">@Text["Projekt"]</option></select></label><label>@Text["Naziv"]<input name="name" required maxlength="100"></label><button>@Text["Dodaj"]</button></form>
<p>@Text["Jedinice"]: @Model.Units.Count · @Text["Timovi"]: @Model.Teams.Count · @Text["Projekti"]: @Model.Projects.Count</p>
@foreach(var scope in Model.Teams){<p><span class="badge">@Text["Tim"]</span> @scope.Name</p>}
@foreach(var scope in Model.Projects){<p><span class="badge">@Text["Projekt"]</span> @scope.Name</p>}
</section>}</div>
