@page
@model TeamManager.Web.Pages.MailIntakeModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
<p><a asp-page="/Project" asp-route-id="@Model.Project.Id">@Model.Project.Input.Name</a></p>
<h1>@Text["Ulazna e-pošta"]</h1>

<section class="card">
    <p>@Text["Pristupnik e-pošte šalje tekst poruke ovoj aplikaciji i otvara privatni zadatak."]</p>
    <dl>
        <dt>@Text["Status konfiguracije"]</dt>
        <dd>@Text[Model.EmployeeNumber is null ? "Pristupnik nije konfiguriran." : "Pristupnik je konfiguriran."]</dd>
        <dt>@Text["Putanja za zaprimanje"]</dt>
        <dd><code>POST @Url.Content($"~/mail/intake/{Model.Project.Id}")</code></dd>
        @if (Model.EmployeeNumber is not null)
        {
            <dt>@Text["Račun za kreiranje zadataka"]</dt>
            <dd>@Model.EmployeeNumber</dd>
        }
    </dl>
</section>

<section class="card">
    <h2>@Text["IMAP sandučić"]</h2>
    @if (!Model.ImapConfigured)
    {
        <p>@Text["IMAP sandučić nije konfiguriran."]</p>
    }
    else if (Model.ImapStatus is not { } status)
    {
        <p>@Text["Čeka prvu provjeru sandučića."]</p>
    }
    else
    {
        <p>@Text[status.Healthy ? "Zadnja provjera sandučića uspjela je." : "Provjera sandučića ili uvoz nisu uspjeli."]</p>
        <p><time datetime="@status.CheckedAt.ToString("O")">@status.CheckedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss") UTC</time></p>
        @if (status.LastIssueId is int issueId)
        {
            <p><a asp-page="/Issue" asp-route-id="@issueId">@Text["Posljednji uvezeni zadatak"]</a></p>
        }
    }
</section>
