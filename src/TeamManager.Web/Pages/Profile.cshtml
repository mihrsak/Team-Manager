@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.ProfileModel
<p class="muted">@Text["KORISNICI / PROFIL"]</p><h1>@Model.Person!.DisplayName</h1><p>@Text["Broj radnika"]: <strong>@Model.Person.EmployeeNumber</strong></p>
@if(TempData["Notice"] is string notice){<p class="notice">@Text[notice]</p>}
<div asp-validation-summary="All"></div>
@if (Model.IsSelf || User.IsInRole("users.manage"))
{
    <p><a asp-page="/CustomFields" asp-route-scope="user" asp-route-entityId="@Model.Person!.Id">@Text["Polja korisnika"]</a></p>
}
@if (Model.IsSelf)
{
    var language = User.FindFirst(UserStore.LanguageClaim)?.Value ?? "hr";
    <section class="card" lang="@language">
        <h2>@Text["Jezik sučelja"]</h2>
        <form method="post" asp-page-handler="Language">
            <label>@Text["Jezik sučelja"]
                <select name="language">
                    <option value="hr" selected="@(language == "hr")">Hrvatski</option>
                    <option value="en" selected="@(language == "en")">English</option>
                </select>
            </label>
            <button>@Text["Spremi jezik"]</button>
        </form>
    </section>
    var theme = User.FindFirst(UserStore.ThemeClaim)?.Value ?? "light";
    <section class="card" lang="@language">
        <h2>@Text["Tema prikaza"]</h2>
        <form method="post" asp-page-handler="Theme">
            <label>@Text["Tema"]
                <select name="theme">
                    <option value="light" selected="@(theme == "light")">@Text["Svijetla"]</option>
                    <option value="dark" selected="@(theme == "dark")">@Text["Tamna"]</option>
                    <option value="system" selected="@(theme == "system")">@Text["Prema postavci uređaja"]</option>
                </select>
            </label>
            <button>@Text["Spremi temu"]</button>
        </form>
    </section>
}
@if (User.IsInRole("*") && !Model.IsSelf)
{
    <section class="card">
        <h2>@Text["Korisnički račun"]</h2>
        <p>@(Model.Person.IsActive ? Text["Aktivan račun"].Value : Text["Deaktiviran račun"].Value)</p>
        <form method="post" asp-page-handler="Account" asp-route-id="@Model.Person.Id">
            <button name="accountAction" value="@(Model.Person.IsActive ? "deactivate" : "activate")">@(Model.Person.IsActive ? Text["Deaktiviraj račun"].Value : Text["Aktiviraj račun"].Value)</button>
            <button name="accountAction" value="revoke">@Text["Opozovi sesije"]</button>
        </form>
        <form method="post" asp-page-handler="Account" asp-route-id="@Model.Person.Id">
            <label>@Text["Nova lozinka"]<input name="password" type="password" required minlength="10" maxlength="200" autocomplete="new-password"></label>
            <button name="accountAction" value="reset">@Text["Resetiraj lozinku"]</button>
        </form>
    </section>
}
<section class="card"><h2>@Text["Globalne role"]</h2><p>@(Model.GlobalRoles.Count==0?Text["Nema globalnih rola"].Value:string.Join(", ",Model.GlobalRoles))</p>
@if(User.IsInRole("roles.manage")){<form method="post" asp-page-handler="GlobalRole" asp-route-id="@Model.Person.Id"><label>@Text["Rola"]<select name="role">@foreach(var role in Model.Roles){<option>@role.Name</option>}</select></label><button name="remove" value="false">@Text["Dodijeli"]</button> <button name="remove" value="true">@Text["Ukloni"]</button></form>}
</section>
<div class="grid"><section class="card"><h2>@Text["Osnovni podaci"]</h2>
@if(Model.CanEdit){<form method="post" asp-page-handler="Save" asp-route-id="@Model.Person.Id"><label>@Text["Ime i prezime"]<input name="name" value="@Model.Person.DisplayName" required maxlength="100"></label><label>@Text["Funkcija"]<input name="job" value="@Model.Person.JobTitle" maxlength="100"></label>
@if(User.IsInRole("users.manage")){<label>@Text["Organizacijska jedinica"]<select name="unit"><option value="">@Text["Nije dodijeljena"]</option>@foreach(var unit in Model.Units){<option value="@unit.Id" selected="@(unit.Id==Model.Person.OrganizationUnitId)">@unit.Name</option>}</select></label>}
else{<p>@Text["Organizacijska jedinica"]: @Model.UnitName</p>}
<button>@Text["Spremi podatke"]</button></form>}
else{<p>@Text["Funkcija"]: @Model.Person.JobTitle</p><p>@Text["Organizacijska jedinica"]: @Model.UnitName</p>}
</section>
@if(Model.IsSelf){<section class="card"><h2>@Text["Promjena lozinke"]</h2><form method="post" asp-page-handler="Password" asp-route-id="@Model.Person.Id"><label>@Text["Trenutna lozinka"]<input name="currentPassword" type="password" required maxlength="200" autocomplete="current-password"></label><label>@Text["Nova lozinka"]<input name="newPassword" type="password" required minlength="10" maxlength="200" autocomplete="new-password"></label><label>@Text["Ponovi novu lozinku"]<input name="confirmPassword" type="password" required maxlength="200" autocomplete="new-password"></label><button>@Text["Promijeni lozinku"]</button></form></section>}
</div>
<div class="grid">
@foreach(var kind in new[]{"team","project"}){var memberships=kind=="team"?Model.Teams:Model.Projects;var choices=kind=="team"?Model.TeamChoices:Model.ProjectChoices; var manageable=kind=="team"?Model.ManageTeams:Model.ManageProjects;
<section class="card"><h2>@(kind=="team"?Text["Timovi"].Value:"Projekti")</h2>
@if(memberships.Count==0){<p class="muted">@Text["Nema dodijeljenih članstava."]</p>}
@foreach(var member in memberships){<div class="actions"><p>@member.Scope · <strong>@member.Role</strong></p>@if(manageable.Contains(member.ScopeId)){<form method="post" asp-page-handler="@(member.IsAdditional ? "Membership" : "Remove")" asp-route-id="@Model.Person.Id">@if(member.IsAdditional){<input type="hidden" name="removeRole" value="true"><input type="hidden" name="role" value="@member.Role">}<input type="hidden" name="kind" value="@kind"><input type="hidden" name="scopeId" value="@member.ScopeId"><button>@(member.IsAdditional ? Text["Ukloni ulogu"].Value : Text["Ukloni članstvo"].Value)</button></form>}</div>}
@if(manageable.Count>0){<form method="post" asp-page-handler="Membership" asp-route-id="@Model.Person.Id"><input type="hidden" name="kind" value="@kind"><label>@(kind=="team"?Text["Tim"].Value:"Projekt")<select name="scopeId" required><option value="">@Text["Odaberi"]</option>@foreach(var choice in choices.Where(x=>manageable.Contains(x.Id))){<option value="@choice.Id">@choice.Name</option>}</select></label><label>@Text["Uloga"]<select name="role">@foreach(var role in Model.Roles){<option>@role.Name</option>}</select></label><button>@Text["Dodaj ulogu"]</button> <button name="replacePrimary" value="true">@Text["Zamijeni osnovnu ulogu"]</button></form>}
</section>}
</div><p class="muted">@Text["Uloga vrijedi samo unutar odabranog tima ili projekta. Administracija korisnika zasebna je ovlast."]</p>
