@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.NotificationsModel
@using TeamManager.Web.Pages
<h1>@Text["Obavijesti"]</h1>
<form method="get" class="card"><div asp-validation-summary="All"></div><label>@Text["Pretraga"]<input asp-for="Query" type="search" maxlength="200"></label><button>@Text["Primijeni"]</button></form>
@if(Model.FiltersValid)
{
@if (Model.Entries.Count == 0)
{
    <p>@Text["Nema obavijesti za praćene zadatke."]</p>
}
else
{
    <div class="card table">
        <table>
            <caption>@Text["Obavijesti"] · @Text["Stranica {0}",Model.PageNumber]</caption>
            <thead><tr><th>@Text["Zadatak"]</th><th>@Text["Aktivnost"]</th><th>@Text["Vrijeme (UTC)"]</th><th>@Text["Status"]</th></tr></thead>
            <tbody>
                @foreach (var entry in Model.Entries)
                {
                    <tr>
                        <td><a asp-page="/Issue" asp-route-id="@entry.IssueId">@entry.Title</a> · @entry.Project</td>
                        <td>@Text[ActivityModel.KindLabel(entry.Kind)]</td>
                        <td>@entry.At.ToString("g")</td>
                        <td>
                            @if (entry.IsRead)
                            {
                                <span>@Text["Pročitano"]</span>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Read" asp-route-eventId="@entry.EventId" asp-route-pageNumber="@Model.PageNumber" asp-route-query="@Model.Query">
                                    <button>@Text["Označi kao pročitano"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="pagination" role="navigation" aria-label="@Text["Stranice rezultata"]">@if(Model.PageNumber>1){<a href="@Model.PageUrl(Model.PageNumber-1)">@Text["Prethodna stranica"]</a>} <span>@Text["Stranica {0}",Model.PageNumber]</span> @if(Model.HasMore){<a href="@Model.PageUrl(Model.PageNumber+1)">@Text["Sljedeća stranica"]</a>}</div>
}
