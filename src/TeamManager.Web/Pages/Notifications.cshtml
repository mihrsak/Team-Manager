@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.NotificationsModel
@using TeamManager.Web.Pages
<h1>@Text["Obavijesti"]</h1>
@if (Model.Entries.Count == 0)
{
    <p>@Text["Nema obavijesti za praćene zadatke."]</p>
}
else
{
    <div class="card table">
        <table>
            <caption>@Text["Do 50 obavijesti, nepročitane prve"]</caption>
            <thead><tr><th>@Text["Zadatak"]</th><th>@Text["Aktivnost"]</th><th>@Text["Vrijeme (UTC)"]</th><th>@Text["Status"]</th></tr></thead>
            <tbody>
                @foreach (var entry in Model.Entries)
                {
                    <tr>
                        <td><a asp-page="/Issue" asp-route-id="@entry.IssueId">@entry.Title</a> · @entry.Project</td>
                        <td>@Text[ActivityModel.KindLabel(entry.Kind)]</td>
                        <td>@entry.At.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (entry.IsRead)
                            {
                                <span>@Text["Pročitano"]</span>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Read" asp-route-eventId="@entry.EventId">
                                    <button>@Text["Označi kao pročitano"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
