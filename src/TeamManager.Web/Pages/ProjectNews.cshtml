@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.ProjectNewsModel
<p><a asp-page="/Project" asp-route-id="@Model.Project.Id">@Model.Project.Input.Name</a></p>
<h1>@Text["Projektne novosti"]</h1>
<div asp-validation-summary="All"></div>

@if (Model.NewsId is int selected)
{
    <p><a asp-page="/ProjectNews" asp-route-projectId="@Model.Project.Id">@Text["Sve novosti projekta"]</a></p>
    var item = Model.Items[0];
    <article class="card">
        <h2>@item.Title</h2>
        <p>@item.Author · @item.At.ToString("g") UTC</p>
        <p style="white-space:pre-wrap">@item.Body</p>
    </article>

    <section class="card">
        <h2>@Text["Komentari"] (@Model.Comments.Count)</h2>
        @foreach (var comment in Model.Comments)
        {
            <article>
                <small>@comment.Author · @comment.At.ToString("g") UTC</small>
                <p style="white-space:pre-wrap">@comment.Body</p>
            </article>
        }
        @if (Model.CanComment)
        {
            <form method="post" asp-page-handler="Comment" data-unsaved-draft="@(Model.HasDraft ? "true" : null)" asp-route-projectId="@Model.Project.Id" asp-route-newsId="@selected">
                <label>@Text["Komentar"]<textarea name="body" rows="3" maxlength="2000" required>@("\n"+Model.DraftBody)</textarea></label>
                <button>@Text["Dodaj komentar"]</button>
            </form>
        }
    </section>
}
else
{
    @if (Model.CanPublish)
    {
        <section class="card">
            <h2>@Text["Nova objava"]</h2>
            <form method="post" asp-page-handler="Publish" data-unsaved-draft="@(Model.HasDraft ? "true" : null)" asp-route-projectId="@Model.Project.Id">
                <label>@Text["Naslov"]<input name="title" maxlength="150" required value="@Model.DraftTitle"></label>
                <label>@Text["Tekst objave"]<textarea name="body" rows="5" maxlength="4000" required>@("\n"+Model.DraftBody)</textarea></label>
                <button>@Text["Objavi"]</button>
            </form>
        </section>
    }

    @if (Model.Items.Count == 0)
    {
        <p>@Text["Nema objavljenih novosti."]</p>
    }
    else
    {
        <ul class="card">
            @foreach (var item in Model.Items)
            {
                <li><a asp-page="/ProjectNews" asp-route-projectId="@Model.Project.Id" asp-route-newsId="@item.Id">@item.Title</a>
                    · @item.Author · @item.At.ToString("d")
                </li>
            }
        </ul>
    }
}
