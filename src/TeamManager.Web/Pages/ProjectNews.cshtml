@page
@model TeamManager.Web.Pages.ProjectNewsModel
<p><a asp-page="/Project" asp-route-id="@Model.Project.Id">@Model.Project.Input.Name</a></p>
<h1>Projektne novosti</h1>
<div asp-validation-summary="All"></div>

@if (Model.NewsId is int selected)
{
    <p><a asp-page="/ProjectNews" asp-route-projectId="@Model.Project.Id">Sve novosti projekta</a></p>
    var item = Model.Items[0];
    <article class="card">
        <h2>@item.Title</h2>
        <p>@item.Author · @item.At.ToString("dd.MM.yyyy HH:mm") UTC</p>
        <p style="white-space:pre-wrap">@item.Body</p>
    </article>

    <section class="card">
        <h2>Komentari (@Model.Comments.Count)</h2>
        @foreach (var comment in Model.Comments)
        {
            <article>
                <small>@comment.Author · @comment.At.ToString("dd.MM.yyyy HH:mm") UTC</small>
                <p style="white-space:pre-wrap">@comment.Body</p>
            </article>
        }
        @if (Model.CanComment)
        {
            <form method="post" asp-page-handler="Comment" asp-route-projectId="@Model.Project.Id" asp-route-newsId="@selected">
                <label>Komentar<textarea name="body" rows="3" maxlength="2000" required></textarea></label>
                <button>Dodaj komentar</button>
            </form>
        }
    </section>
}
else
{
    @if (Model.CanPublish)
    {
        <section class="card">
            <h2>Nova objava</h2>
            <form method="post" asp-page-handler="Publish" asp-route-projectId="@Model.Project.Id">
                <label>Naslov<input name="title" maxlength="150" required></label>
                <label>Tekst objave<textarea name="body" rows="5" maxlength="4000" required></textarea></label>
                <button>Objavi</button>
            </form>
        </section>
    }

    @if (Model.Items.Count == 0)
    {
        <p>Nema objavljenih novosti.</p>
    }
    else
    {
        <ul class="card">
            @foreach (var item in Model.Items)
            {
                <li><a asp-page="/ProjectNews" asp-route-projectId="@Model.Project.Id" asp-route-newsId="@item.Id">@item.Title</a>
                    · @item.Author · @item.At.ToString("dd.MM.yyyy")
                </li>
            }
        </ul>
    }
}
