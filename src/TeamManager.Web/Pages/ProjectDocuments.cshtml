@page
@model TeamManager.Web.Pages.ProjectDocumentsModel
<p><a asp-page="/Project" asp-route-id="@Model.Project.Id">@Model.Project.Input.Name</a></p>
<h1>Dokumenti projekta</h1>
<div asp-validation-summary="All"></div>

@if (Model.CanEdit)
{
    <section class="card">
        <h2>Novi dokument</h2>
        <form method="post" asp-page-handler="Add" asp-route-projectId="@Model.Project.Id" enctype="multipart/form-data">
            <label>Naslov<input name="title" maxlength="150" required></label>
            <label>Opis<textarea name="description" maxlength="2000" rows="3"></textarea></label>
            <label>Datoteka (do 10 MiB)<input name="attachment" type="file" required></label>
            <button>Dodaj dokument</button>
        </form>
    </section>
}

@if (Model.Documents.Count == 0)
{
    <p>Projekt još nema dokumenata.</p>
}
@foreach (var document in Model.Documents)
{
    <article class="card">
        <h2>@document.Title</h2>
        <p>@document.Author · @document.At.ToString("dd.MM.yyyy HH:mm") UTC</p>
        @if (document.Description.Length > 0)
        {
            <p style="white-space:pre-wrap;overflow-wrap:anywhere">@document.Description</p>
        }
        <div class="actions">
            <a asp-page-handler="Download" asp-route-projectId="@Model.Project.Id" asp-route-documentId="@document.Id">@document.FileName</a>
            <span>@document.Size B</span>
            @if (Model.CanEdit)
            {
                <form method="post" asp-page-handler="Remove" asp-route-projectId="@Model.Project.Id" asp-route-documentId="@document.Id">
                    <button aria-label="Ukloni dokument @document.Title">Ukloni</button>
                </form>
            }
        </div>
    </article>
}
