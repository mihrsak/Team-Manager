@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.ProjectDocumentsModel
<p><a asp-page="/Project" asp-route-id="@Model.Project.Id">@Model.Project.Input.Name</a></p>
<h1>@Text["Dokumenti projekta"]</h1>
<div asp-validation-summary="All"></div>

@if (Model.CanEdit)
{
    <section class="card">
        <h2>@Text["Novi dokument"]</h2>
        <form method="post" asp-page-handler="Add" asp-route-projectId="@Model.Project.Id" enctype="multipart/form-data" data-unsaved-draft="@(Model.HasDraft ? "true" : null)">
            <label>@Text["Naslov"]<input name="title" maxlength="150" required value="@Model.DraftTitle"></label>
            <label>@Text["Opis"]<textarea name="description" maxlength="2000" rows="3">@("\n"+Model.DraftDescription)</textarea></label>
            @if(Model.HasDraft){<p id="document-file-reselect" class="notice">@Text["Nacrt je sačuvan. Ponovno odaberi datoteku prije slanja."]</p>}
            <label>@Text["Datoteka (do 10 MiB)"]<input name="attachment" type="file" required aria-describedby="@(Model.HasDraft ? "document-file-reselect" : null)"></label>
            <button>@Text["Dodaj dokument"]</button>
        </form>
    </section>
}

@if (Model.Documents.Count == 0)
{
    <p>@Text["Projekt još nema dokumenata."]</p>
}
@foreach (var document in Model.Documents)
{
    <article class="card">
        <h2>@document.Title</h2>
        <p>@document.Author · @document.At.ToString("g") UTC</p>
        @if (document.Description.Length > 0)
        {
            <p style="white-space:pre-wrap;overflow-wrap:anywhere">@document.Description</p>
        }
        <div class="actions">
            <a download asp-page-handler="Download" asp-route-projectId="@Model.Project.Id" asp-route-documentId="@document.Id">@document.FileName</a>
            <span>@document.Size B</span>
            @if (Model.CanEdit)
            {
                <form method="post" asp-page-handler="Remove" asp-route-projectId="@Model.Project.Id" asp-route-documentId="@document.Id">
                    <button aria-label="@Text["Ukloni dokument {0}", document.Title]">@Text["Ukloni"]</button>
                </form>
            }
        </div>
    </article>
}
