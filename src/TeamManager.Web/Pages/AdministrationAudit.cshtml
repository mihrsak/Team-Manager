@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.AdministrationAuditModel
@using TeamManager.Web.Pages
<h1>@Text["Revizijski zapis"]</h1>
<form method="get" class="card"><label>@Text["Pretraga"]<input asp-for="Query" type="search" maxlength="200"></label><button>@Text["Primijeni"]</button></form>
@if (Model.Entries.Count == 0)
{
    <p>@Text["Nema zabilježenih administrativnih radnji."]</p>
}
else
{
    <div class="card table">
        <table>
            <caption>@Text["Zadnjih {0} zapisa", Model.Entries.Count]</caption>
            <thead><tr><th>@Text["Vrijeme (UTC)"]</th><th>@Text["Administrator"]</th><th>@Text["Radnja"]</th><th>@Text["Stavka"]</th><th>@Text["Detalji"]</th></tr></thead>
            <tbody>
                @foreach (var entry in Model.Entries)
                {
                    <tr>
                        <td>@entry.At.ToString("G")</td>
                        <td>@entry.Actor</td>
                        <td>@Text[AdministrationAuditModel.Label(entry.Action)]</td>
                        <td>@entry.Subject</td><td>@entry.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="pagination" role="navigation" aria-label="@Text["Stranice rezultata"]">@if(Model.PageNumber>1){<a href="@Model.PageUrl(Model.PageNumber-1)">@Text["Prethodna stranica"]</a>} <span>@Text["Stranica {0}",Model.PageNumber]</span> @if(Model.HasMore){<a href="@Model.PageUrl(Model.PageNumber+1)">@Text["Sljedeća stranica"]</a>}</div>