@page
@model TeamManager.Web.Pages.AdministrationAuditModel
@using TeamManager.Web.Pages
<h1>Revizijski zapis</h1>
@if (Model.Entries.Count == 0)
{
    <p>Nema zabilježenih administrativnih radnji.</p>
}
else
{
    <div class="card table">
        <table>
            <caption>Zadnjih @Model.Entries.Count zapisa</caption>
            <thead><tr><th>Vrijeme (UTC)</th><th>Administrator</th><th>Radnja</th><th>Račun</th></tr></thead>
            <tbody>
                @foreach (var entry in Model.Entries)
                {
                    <tr>
                        <td>@entry.At.ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td>@entry.Actor</td>
                        <td>@AdministrationAuditModel.Label(entry.Action)</td>
                        <td>@entry.Subject</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
