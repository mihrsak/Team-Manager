@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.TimeEntryModel
<p><a href="@Model.BackUrl">@Text[Model.BackLabel]</a></p>
<h1>@Text["Detalji unosa vremena"]</h1>
<section class="card" aria-label="@Text["Podaci o unosu vremena"]">
 <h2>@Text["Unos vremena #{0}",Model.Entry.Id]</h2>
 <dl>
  <dt>@Text["Autor"]</dt><dd>@Model.Entry.AuthorName (@Model.Entry.AuthorEmployeeNumber)</dd>
  <dt>@Text["Projekt"]</dt><dd><a asp-page="/Project" asp-route-id="@Model.Entry.ProjectId">@Model.Entry.ProjectName</a></dd>
  <dt>@Text["Zadatak"]</dt><dd><a asp-page="/Issue" asp-route-id="@Model.Entry.IssueId">#@Model.Entry.IssueId · @Model.Entry.IssueTitle</a></dd>
 </dl>
</section>
<p>@Text["Ispravak zadržava autora i povezana polja. Prethodne i nove vrijednosti ostaju u povijesti zadatka."]</p>
@if(!Model.CanCorrect){<p>@Text["Ovaj unos možeš samo pregledati."]</p>}
<form method="post" class="card" data-unsaved-draft="@(!ViewData.ModelState.IsValid ? "true" : null)">
 <div asp-validation-summary="All"></div>
 @if(Model.HasConflict)
 {
  <section class="notice" data-current-time aria-label="@Text["Aktualna spremljena verzija"]">
   <h2>@Text["Aktualna spremljena verzija"]</h2>
   <dl>
    <dt>@Text["Datum"]</dt><dd>@Model.Entry.Date.ToString("d")</dd>
    <dt>@Text["Sati"]</dt><dd>@Model.Entry.Hours.ToString("0.00")</dd>
    <dt>@Text["Aktivnost"]</dt><dd>@Model.Entry.Activity</dd>
    <dt>@Text["Napomena"]</dt><dd style="white-space:pre-wrap">@Model.Entry.Note</dd>
   </dl>
  </section>
  <input type="hidden" name="reviewedToken" value="@Model.Entry.Token">
  <label><input type="checkbox" name="resolveConflict" value="true" required> @Text["Pregledao sam aktualnu verziju i želim spremiti ovaj nacrt umjesto nje."]</label>
 }
 <input type="hidden" asp-for="IssueId"><input type="hidden" asp-for="Id"><input type="hidden" asp-for="Token">
 <fieldset disabled="@(!Model.CanCorrect)">
  <label>@Text["Datum"]<input asp-for="Date" type="date" required></label>
  <label>@Text["Sati"]<input asp-for="Hours" inputmode="decimal" required></label>
  <label>@Text["Aktivnost"]<input asp-for="Activity" maxlength="60" required></label>
  <label>@Text["Napomena"]<textarea asp-for="Note" maxlength="1000"></textarea></label>
  @if(Model.CanCorrect){<button>@Text["Spremi ispravak"]</button>}
 </fieldset>
</form>
