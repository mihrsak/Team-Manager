@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@inject IConfiguration Configuration
<!doctype html><html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="@(User.FindFirst(UserStore.ThemeClaim)?.Value ?? "light")"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@Text[PageLabels.For(ViewContext.RouteData.Values["page"]?.ToString())] · Team Manager</title>
<style>
html {
    color-scheme: light;
    --page: #f3f6fa; --surface: #fff; --text: #182b44; --secondary: #42556a;
    --muted: #607086; --line: #dde5ed; --field-line: #b6c7d6; --link: #176a70;
    --nav: #122c48; --badge: #e9f0f6; --notice: #def3ec;
    --error: #a22626; --error-surface: #fff0f0;
}
html[data-theme="dark"] {
    color-scheme: dark;
    --page: #131d29; --surface: #1d2b3a; --text: #e3edf8; --secondary: #cad7e6;
    --muted: #a4b5c7; --line: #394d61; --field-line: #647d93; --link: #8fddd9;
    --nav: #0e1825; --badge: #30445a; --notice: #244539;
    --error: #ffc8c8; --error-surface: #4d2c32;
}
@@media (prefers-color-scheme: dark) {
    html[data-theme="system"] {
        color-scheme: dark;
        --page: #131d29; --surface: #1d2b3a; --text: #e3edf8; --secondary: #cad7e6;
        --muted: #a4b5c7; --line: #394d61; --field-line: #647d93; --link: #8fddd9;
        --nav: #0e1825; --badge: #30445a; --notice: #244539;
        --error: #ffc8c8; --error-surface: #4d2c32;
    }
}
*{box-sizing:border-box}body{margin:0;background:var(--page);color:var(--text);font:15px 'Segoe UI',sans-serif}nav{background:var(--nav);padding:18px 5%;display:flex;flex-wrap:wrap;gap:16px;align-items:center;color:white}nav a{color:white;text-decoration:none}nav strong{margin-right:auto}main{max-width:1180px;margin:36px auto;padding:0 24px}h1{font-size:32px}h2{font-size:20px}.card{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:24px;margin:20px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px}label{display:block;margin:12px 0;color:var(--secondary)}input,select,textarea{background:var(--surface);color:var(--text);display:block;width:100%;padding:10px;border:1px solid var(--field-line);border-radius:6px;margin-top:6px;font:inherit}button,.button{background:#176a70;color:white;border:0;border-radius:6px;padding:10px 16px;cursor:pointer;font:inherit}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:12px 8px;border-bottom:1px solid var(--line)}.table{overflow:auto}a{color:var(--link)}.muted{color:var(--muted)}.validation-summary-errors,.error{color:var(--error);background:var(--error-surface);padding:12px}.notice{background:var(--notice);padding:14px;border-radius:6px}.inline{display:inline}nav form{margin:0}.badge{padding:4px 8px;border-radius:6px;background:var(--badge)}.actions{display:flex;gap:10px;align-items:center}
.skip-link{position:fixed;top:8px;left:8px;z-index:10;padding:10px 14px;background:var(--surface);color:var(--link);transform:translateY(calc(-100% - 8px))}
.skip-link:focus{transform:none}
.grid{grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))}
.validation-summary-valid{display:none}
.admin-links,.pagination{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin:16px 0}
.table-scroll{max-width:100%;overflow-x:auto}
main{overflow-wrap:anywhere}
.table-scroll:focus-visible{outline:2px solid var(--link);outline-offset:3px}
.responsive-table-scroll{min-width:0;width:100%;overscroll-behavior-x:contain}
.responsive-table{min-width:40rem}
.responsive-table th,.responsive-table td{min-width:7rem;max-width:28rem;overflow-wrap:anywhere}
.responsive-table th{white-space:nowrap}
.issue-time-table{min-width:48rem;table-layout:fixed}
.issue-time-table th:nth-child(1){width:16%}
.issue-time-table th:nth-child(2),.issue-time-table th:nth-child(3),.issue-time-table th:nth-child(6){width:18%}
.issue-time-table th:nth-child(4){width:8%}
.issue-time-table th:nth-child(5){width:22%}
.issue-time-table td{overflow-wrap:anywhere}
nav a[aria-current="page"],.admin-links a[aria-current="page"]{text-decoration:underline;text-underline-offset:6px;font-weight:700}
details>summary{cursor:pointer;padding:12px 0;font-weight:600}
</style><script src="~/js/forms.js" asp-append-version="true" defer></script></head><body data-unsaved-message="@Text["Imaš nespremljene izmjene. Želiš li napustiti stranicu i odbaciti ih?"]">
<a class="skip-link" href="#main-content">@Text["Preskoči na glavni sadržaj"]</a>
<nav data-primary-navigation aria-label="@Text["Glavna navigacija"]"><strong>TEAM MANAGER</strong>@if(User.Identity?.IsAuthenticated==true){<a navigation="primary" asp-page="/Dashboard">@Text["Moji zadaci"]</a><a navigation="primary" asp-page="/Search">@Text["Pretraga"]</a><a navigation="primary" href="/Projects">@Text["Projekti"]</a><a navigation="primary" href="/Issues">@Text["Zadaci"]</a><a navigation="primary" asp-page="/Calendar">@Text["Kalendar"]</a><a navigation="primary" asp-page="/Activity">@Text["Aktivnosti"]</a><a navigation="primary" asp-page="/Notifications">@Text["Obavijesti"]</a><a navigation="primary" asp-page="/TimeReport">@Text["Izvještaj o vremenu"]</a><a navigation="primary" href="/Users">@Text["Korisnici"]</a><a navigation="primary" href="/Profile">@Text["Moj profil"]</a><span>@User.Identity.Name</span><form method="post" asp-page="/Logout"><button>@Text["Odjava"]</button></form>}</nav>
<main id="main-content" tabindex="-1"><div class="admin-links" role="navigation" aria-label="@Text["Administracija"]">@if(User.IsInRole("roles.manage")){<a navigation="administration" href="/Roles" lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">@Text["Role i ovlasti"]</a> @if(OracleOverviewStore.Enabled(Configuration)){<a navigation="administration" asp-page="/OracleOverview">@Text["Oracle pregled zadataka"]</a>}} @if(User.IsInRole("workflow.manage")){<a navigation="administration" href="/Workflow" lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">@Text["Tijek rada"]</a>}</div> @await Html.PartialAsync("_ReturnNavigation") @RenderBody()</main></body></html>
