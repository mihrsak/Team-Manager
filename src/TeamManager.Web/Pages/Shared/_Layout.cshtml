<!doctype html><html lang="hr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Team Manager</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f3f6fa;color:#182b44;font:15px 'Segoe UI',sans-serif}nav{background:#122c48;padding:18px 5%;display:flex;gap:24px;align-items:center;color:white}nav a{color:white;text-decoration:none}nav strong{margin-right:auto}main{max-width:1180px;margin:36px auto;padding:0 24px}h1{font-size:32px}h2{font-size:20px}.card{background:white;border:1px solid #dde5ed;border-radius:12px;padding:24px;margin:20px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px}label{display:block;margin:12px 0;color:#42556a}input,select{display:block;width:100%;padding:10px;border:1px solid #b6c7d6;border-radius:6px;margin-top:6px;font:inherit}button,.button{background:#176a70;color:white;border:0;border-radius:6px;padding:10px 16px;cursor:pointer;font:inherit}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:12px 8px;border-bottom:1px solid #e1e8f0}.table{overflow:auto}a{color:#176a70}.muted{color:#607086}.validation-summary-errors,.error{color:#a22626;background:#fff0f0;padding:12px}.notice{background:#def3ec;padding:14px;border-radius:6px}.inline{display:inline}nav form{margin:0}.badge{padding:4px 8px;border-radius:6px;background:#e9f0f6}.actions{display:flex;gap:10px;align-items:center}
</style></head><body>
<nav><strong>TEAM MANAGER</strong>@if(User.Identity?.IsAuthenticated==true){<a href="/Issues">Projekti i zadaci</a><a href="/Users">Korisnici</a><a href="/Profile">Moj profil</a><span>@User.Identity.Name</span><form method="post" asp-page="/Logout"><button>Odjava</button></form>}</nav>
<main>@if(User.IsInRole("roles.manage")){<a href="/Roles">Role i ovlasti</a>} @if(User.IsInRole("workflow.manage")){<a href="/Workflow">Tijek rada</a>} @RenderBody()</main></body></html>
