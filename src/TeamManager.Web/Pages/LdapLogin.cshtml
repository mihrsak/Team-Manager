@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.LdapLoginModel

<div class="card" style="max-width:440px;margin:60px auto">
    <h1>@Text["LDAP prijava"]</h1>
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" role="alert" tabindex="-1" autofocus></div>
    }
    <form method="post" asp-page="/LdapLogin">
        <label>@Text["Broj radnika"]<input asp-for="EmployeeNumber" autocomplete="username" required maxlength="30"></label>
        <label>@Text["Lozinka direktorija"]<input asp-for="Password" type="password" autocomplete="current-password" required maxlength="200"></label>
        <button>@Text["Prijavi se putem LDAP-a"]</button>
    </form>
    <p><a asp-page="/Login">@Text["Natrag na prijavu"]</a></p>
</div>
