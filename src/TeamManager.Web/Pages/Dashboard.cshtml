@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.DashboardModel
<h1>@Text["Moji zadaci"]</h1>

@{
    var groups = new[]
    {
        (Name: Text["Rok je prošao"], Issues: Model.Overdue),
        (Name: Text["Predstojeći rokovi"], Issues: Model.WithDeadline),
        (Name: Text["Bez roka"], Issues: Model.WithoutDeadline),
        (Name: Text["Pratim"], Issues: Model.Watched)
    };
}
@foreach (var group in groups)
{
    <section class="card table">
        <h2>@group.Name (@group.Issues.Count)</h2>
        @if (group.Issues.Count == 0)
        {
            <p>@Text["Nema zadataka u ovoj skupini."]</p>
        }
        else
        {
            <table>
                <thead><tr><th>@Text["Zadatak"]</th><th>@Text["Projekt"]</th><th>@Text["Status"]</th><th>@Text["Prioritet"]</th><th>@Text["Rok"]</th></tr></thead>
                <tbody>
                    @foreach (var issue in group.Issues)
                    {
                        <tr>
                            <td><a asp-page="/Issue" asp-route-id="@issue.Id">@issue.Title</a></td>
                            <td>@issue.Project</td><td>@issue.Status</td><td>@issue.Priority</td>
                            <td>@(issue.DueDate?.ToString("d") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}
