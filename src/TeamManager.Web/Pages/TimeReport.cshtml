@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.TimeReportModel
<h1>@Text["Izvještaj o utrošenom vremenu"]</h1>

<section class="card">
    <form method="get">
        <div asp-validation-summary="All"></div>
        <div class="grid">
            <label>@Text["Projekt"]
                <select asp-for="ProjectId">
                    <option value="">@Text["Svi dostupni projekti"]</option>
                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </select>
            </label>
            <label>@Text["Osoba ili broj radnika"]<input asp-for="Person" maxlength="100"></label>
            <label>@Text["Aktivnost"]<input asp-for="Activity" maxlength="60"></label>
            <label>@Text["Od datuma"]<input asp-for="From" type="date"></label>
            <label>@Text["Do datuma"]<input asp-for="To" type="date"></label>
        </div>
        <button>@Text["Prikaži izvještaj"]</button>
    </form>
</section>

@if (ViewData.ModelState.IsValid)
{
    @if (Model.Rows.Count == 0)
    {
        <p>@Text["Za odabrane filtre nema zapisa o utrošenom vremenu."]</p>
    }
    else
    {
        <div class="card table">
            <table>
                <caption>@Text["Ukupno"] @Model.Rows.Sum(row => row.Hours).ToString("0.00") h</caption>
                <thead><tr><th>@Text["Projekt"]</th><th>@Text["Osoba"]</th><th>@Text["Aktivnost"]</th><th>@Text["Sati"]</th></tr></thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr><td>@row.Project</td><td>@row.Person (@row.EmployeeNumber)</td><td>@row.Activity</td><td>@row.Hours.ToString("0.00")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
@if(Model.Details.Count>0)
{
 <section class="card table"><h2>@Text["Detalji unosa vremena"]</h2><table><thead><tr><th>@Text["Datum"]</th><th>@Text["Projekt"]</th><th>@Text["Zadatak"]</th><th>@Text["Osoba"]</th><th>@Text["Aktivnost"]</th><th>@Text["Sati"]</th><th>@Text["Napomena"]</th></tr></thead><tbody>
 @foreach(var row in Model.Details){<tr><td><a asp-page="/TimeEntry" asp-route-id="@row.Id" asp-route-issueId="@row.IssueId">@row.Date.ToString("d")</a></td><td>@row.Project</td><td><a asp-page="/Issue" asp-route-id="@row.IssueId">@row.Title</a></td><td>@row.Person</td><td>@row.Activity</td><td>@row.Hours.ToString("0.00")</td><td>@row.Note</td></tr>}
 </tbody></table></section>
}
@if(Model.PageNumber>1||Model.HasMore){<nav aria-label="@Text["Stranice rezultata"]">@if(Model.PageNumber>1){<a href="@Model.PageUrl(Model.PageNumber-1)">@Text["Prethodna stranica"]</a>} <span>@Text["Stranica {0}",Model.PageNumber]</span> @if(Model.HasMore){<a href="@Model.PageUrl(Model.PageNumber+1)">@Text["Sljedeća stranica"]</a>}</nav>}
