@page
@model TeamManager.Web.Pages.IssueModel
<a href="/Issues">← Projektni zadaci</a><h1>@(Model.Id is null?"Novi zadatak":$"Zadatak #{Model.Id}")</h1><p>@Model.ProjectName</p>
@if(TempData["Notice"] is string notice){<p class="notice">@notice</p>}<div asp-validation-summary="All"></div>
<section class="card"><form method="post" asp-page-handler="Save" asp-route-id="@Model.Id" asp-route-projectId="@Model.ProjectId">
<input type="hidden" asp-for="Input.Revision"><fieldset disabled="@(!Model.CanEdit)" style="border:0;padding:0"><label>Naslov<input asp-for="Input.Title" required maxlength="200"></label><label>Opis<textarea asp-for="Input.Description" rows="5" maxlength="4000" style="width:100%"></textarea></label>
<div class="grid"><label>Tip<select asp-for="Input.Type">@foreach(var v in Model.Types){<option>@v</option>}</select></label><label>Status<select asp-for="Input.Status">@foreach(var v in Model.Statuses){<option>@v</option>}</select></label><label>Prioritet<select asp-for="Input.Priority">@foreach(var v in Model.Priorities){<option>@v</option>}</select></label><label>Nositelj<select asp-for="Input.AssigneeId"><option value="">Nije dodijeljen</option>@foreach(var u in Model.Assignees){<option value="@u.Id">@u.Name</option>}</select></label><label>Rok<input asp-for="Input.DueDate" type="date"></label></div>
@if(Model.CanEdit){<button>Spremi zadatak</button>}</fieldset></form></section>
@if(Model.Id is not null){<div class="grid">
@if(Model.CanComment){<section class="card"><h2>Komentar</h2><form method="post" asp-page-handler="Comment" asp-route-id="@Model.Id"><label>Tekst<textarea name="text" required maxlength="4000" rows="4" style="width:100%"></textarea></label><button>Dodaj komentar</button></form></section>}
@if(Model.CanLogTime){<section class="card"><h2>Evidencija vremena</h2><form method="post" asp-page-handler="Time" asp-route-id="@Model.Id"><label>Datum<input name="date" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required></label><label>Sati<input name="hours" type="number" min="0.01" max="24" step="0.01" required></label><label>Napomena<input name="note" maxlength="1000"></label><button>Spremi vrijeme</button></form></section>}
</div>@if(Model.ShowTime){<section class="card"><h2>Utrošeno vrijeme: @Model.Time.Sum(x=>x.Hours) h</h2><table><thead><tr><th>Datum</th><th>Korisnik</th><th>Sati</th><th>Napomena</th></tr></thead><tbody>@foreach(var t in Model.Time){<tr><td>@t.Date.ToString("dd.MM.yyyy")</td><td>@t.Author</td><td>@t.Hours</td><td>@t.Note</td></tr>}</tbody></table></section>}
<section class="card"><h2>Povijest i komentari</h2>@foreach(var e in Model.Events){<article style="border-bottom:1px solid #ddd;padding:12px 0"><small>@e.Author · @e.At.ToString("dd.MM.yyyy HH:mm") UTC · @e.Kind</small>@if(e.Kind is "created" or "updated"){<details><summary>Promjena zadatka</summary><pre style="white-space:pre-wrap;overflow-wrap:anywhere">@e.Body</pre></details>}else{<p style="white-space:pre-wrap">@e.Body</p>}</article>}</section>}
