@page
@model TeamManager.Web.Pages.IssueModel
<a href="/Issues">← Projektni zadaci</a><h1>@(Model.Id is null?"Novi zadatak":$"Zadatak #{Model.Id}")</h1><p>@Model.ProjectName</p>
@if (Model.Id is not null)
{
    <form method="post" asp-page-handler="Watch" asp-route-id="@Model.Id">
        <button name="watch" value="@(Model.IsWatching ? "false" : "true")">@(Model.IsWatching ? "Prestani pratiti" : "Prati zadatak")</button>
    </form>
}
@if(TempData["Notice"] is string notice){<p class="notice">@notice</p>}<div asp-validation-summary="All"></div>
<section class="card"><form method="post" asp-page-handler="Save" asp-route-id="@Model.Id" asp-route-projectId="@Model.ProjectId">
<input type="hidden" asp-for="Input.Revision"><fieldset disabled="@(!Model.CanEdit)" style="border:0;padding:0"><label>Naslov<input asp-for="Input.Title" required maxlength="200"></label><label>Opis<textarea asp-for="Input.Description" rows="5" maxlength="4000" style="width:100%"></textarea></label>
<div class="grid"><label>Tip<select asp-for="Input.Type">@foreach(var v in Model.Types){<option>@v</option>}</select></label><label>Status<select asp-for="Input.Status">@foreach(var v in Model.Statuses){<option>@v</option>}</select></label><label>Prioritet<select asp-for="Input.Priority">@foreach(var v in Model.Priorities){<option>@v</option>}</select></label><label>Nositelj<select asp-for="Input.AssigneeId"><option value="">Nije dodijeljen</option>@foreach(var u in Model.Assignees){<option value="@u.Id">@u.Name</option>}</select></label><label>Verzija ili prekretnica<select asp-for="Input.RoadmapItemId"><option value="">Bez stavke plana</option>@foreach(var item in Model.RoadmapItems){<option value="@item.Id">@(item.Kind == "version" ? "Verzija" : "Prekretnica") · @item.Name</option>}</select></label><label>Početak<input asp-for="Input.StartDate" type="date"></label><label>Rok<input asp-for="Input.DueDate" type="date"></label></div>
@if(Model.CanEdit){<button>Spremi zadatak</button>}</fieldset></form></section>
@if (Model.Id is not null && Model.CopyProjects.Count > 0)
{
    <section class="card">
        <h2>Kopiranje i premještanje</h2>
        <form method="post" asp-page-handler="Transfer" asp-route-id="@Model.Id">
            <input type="hidden" name="revision" value="@Model.Input.Revision">
            <label>Projekt za kopiju<select name="destination" required>@foreach(var project in Model.CopyProjects){<option value="@project.Id">@project.Name</option>}</select></label>
            <p>Kopija počinje u statusu Novo, bez nositelja i povijesti.</p>
            <button>Kopiraj zadatak</button>
        </form>
        @if (Model.MoveProjects.Count > 0)
        {
            <form method="post" asp-page-handler="Transfer" asp-route-id="@Model.Id">
                <input type="hidden" name="revision" value="@Model.Input.Revision">
                <input type="hidden" name="move" value="true">
                <label>Projekt za premještanje<select name="destination" required>@foreach(var project in Model.MoveProjects){<option value="@project.Id">@project.Name</option>}</select></label>
                <p>Zadatak zadržava komentare, evidenciju vremena i povijest. Nositelj se uklanja ako nije član odredišnog projekta.</p>
                <button>Premjesti zadatak</button>
            </form>
        }
    </section>
}
@if (Model.Id is not null)
{
    <section class="card">
        <h2>Veze zadatka</h2>
        @foreach (var link in Model.Links)
        {
            var relation = (link.Kind, link.Outgoing) switch
            {
                ("blocks", false) => "blockedBy",
                ("parent", false) => "subtaskOf",
                _ => link.Kind
            };
            var label = relation switch
            {
                "related" => "Povezan s",
                "duplicate" => "Duplikat",
                "blocks" => "Blokira",
                "blockedBy" => "Blokiran zadatkom",
                "parent" => "Podzadatak",
                _ => "Nadređeni zadatak"
            };
            <div class="actions">
                <span>@label · <a asp-page="/Issue" asp-route-id="@link.OtherId">#@link.OtherId @link.Title</a></span>
                @if (Model.CanEdit && link.CanEdit)
                {
                    <form method="post" asp-page-handler="Link" asp-route-id="@Model.Id">
                        <input type="hidden" name="otherId" value="@link.OtherId">
                        <input type="hidden" name="relation" value="@relation">
                        <button name="remove" value="true">Ukloni vezu</button>
                    </form>
                }
            </div>
        }
        @if (Model.CanEdit)
        {
            <form method="post" asp-page-handler="Link" asp-route-id="@Model.Id">
                <label>Broj drugog zadatka<input name="otherId" type="number" min="1" required></label>
                <label>Vrsta veze
                    <select name="relation" required>
                        <option value="related">Povezan s</option>
                        <option value="duplicate">Duplikat</option>
                        <option value="blocks">Blokira</option>
                        <option value="blockedBy">Blokiran zadatkom</option>
                        <option value="parent">Podzadatak</option>
                        <option value="subtaskOf">Nadređeni zadatak</option>
                    </select>
                </label>
                <button>Dodaj vezu</button>
            </form>
        }
    </section>
}
@if (Model.Id is not null)
{
    <section class="card">
        <h2>Moje privatne bilješke</h2>
        @foreach (var note in Model.PrivateNotes)
        {
            <p style="white-space:pre-wrap">@note.Body <small>@note.CreatedAt.ToString("dd.MM.yyyy HH:mm") UTC</small></p>
        }
        @if (Model.CanAddPrivateNote)
        {
            <form method="post" asp-page-handler="PrivateNote" asp-route-id="@Model.Id">
                <label>Bilješka vidljiva samo tebi<textarea name="text" maxlength="4000" rows="3" required></textarea></label>
                <button>Spremi bilješku</button>
            </form>
        }
    </section>
}
@if(Model.Id is not null){<div class="grid">
@if(Model.CanComment){<section class="card"><h2>Komentar</h2><form method="post" asp-page-handler="Comment" asp-route-id="@Model.Id"><label>Tekst<textarea name="text" required maxlength="4000" rows="4" style="width:100%"></textarea></label><button>Dodaj komentar</button></form></section>}
@if(Model.CanLogTime){<section class="card"><h2>Evidencija vremena</h2><form method="post" asp-page-handler="Time" asp-route-id="@Model.Id"><label>Datum<input name="date" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required></label><label>Sati<input name="hours" type="number" min="0.01" max="24" step="0.01" required></label><label>Aktivnost<input name="activity" maxlength="60" placeholder="Općenito"></label><label>Napomena<input name="note" maxlength="1000"></label><button>Spremi vrijeme</button></form></section>}
</div>@if(Model.ShowTime){<section class="card"><h2>Utrošeno vrijeme: @Model.Time.Sum(x=>x.Hours) h</h2><table><thead><tr><th>Datum</th><th>Korisnik</th><th>Aktivnost</th><th>Sati</th><th>Napomena</th></tr></thead><tbody>@foreach(var t in Model.Time){<tr><td>@t.Date.ToString("dd.MM.yyyy")</td><td>@t.Author</td><td>@t.Activity</td><td>@t.Hours</td><td>@t.Note</td></tr>}</tbody></table></section>}
<section class="card"><h2>Povijest i komentari</h2>@foreach(var e in Model.Events){<article style="border-bottom:1px solid #ddd;padding:12px 0"><small>@e.Author · @e.At.ToString("dd.MM.yyyy HH:mm") UTC · @e.Kind</small>@if(e.Kind is "created" or "updated"){<details><summary>Promjena zadatka</summary><pre style="white-space:pre-wrap;overflow-wrap:anywhere">@e.Body</pre></details>}else{<p style="white-space:pre-wrap">@e.Body</p>}</article>}</section>}
