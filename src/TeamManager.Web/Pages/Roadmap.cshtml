@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.RoadmapModel
@using System.Globalization
<p><a asp-page="/Project" asp-route-id="@Model.Project.Id">@Model.Project.Input.Name</a></p>
<h1>@Text["Karta planova"]</h1>
<div asp-validation-summary="All"></div>

@if (Model.Items.Count == 0)
{
    <p>@Text["Projekt još nema verzija ni prekretnica."]</p>
}

@{
    var entries = Model.CanEdit
        ? Model.Items.Append(new RoadmapItem(0, "version", "", "", null, false, 0))
        : Model.Items;
    if(Model.CanEdit && Model.Draft is { ItemId: not 0 } missing && !Model.Items.Any(item=>item.Id==missing.ItemId))
        entries=entries.Append(new RoadmapItem(missing.ItemId,"version","","",null,false,0));
}
@foreach (var item in entries)
{
    <section class="card" id="@(item.Id > 0 ? $"plan-{item.Id}" : null)">
        <h2>@(item.Id == 0 ? Text["Nova verzija ili prekretnica"].Value : item.Name)</h2>
        @if (item.Id != 0)
        {
            <p>@(item.Kind == "version" ? Text["Verzija"].Value : Text["Prekretnica"].Value) · @(item.IsComplete ? Text["Dovršeno"].Value : Text["Planirano"].Value)
                @if (item.TargetDate is DateTime date)
                {
                    <span>· @date.ToString("d")</span>
                }
            </p>
            @if (Model.Progress is not null)
            {
                var counts = Model.Progress[item.Id].ToList();
                var total = counts.Sum(count => count.Count);
                var closed = counts.Where(count => count.IsClosed).Sum(count => count.Count);
                if (total == 0)
                {
                    <p>@Text["Nema povezanih zadataka."]</p>
                }
                else
                {
                    <p>@Text["{0} od {1} zatvorenih zadataka ({2} %)", closed, total, (100m * closed / total).ToString("0")]</p>
                    <progress value="@closed" max="@total" aria-label="@Text["Napredak povezanih zadataka"]"></progress>
                    <ul>
                        @foreach (var count in counts)
                        {
                            <li>@count.Status · @count.Count</li>
                        }
                    </ul>
                }
            }
            @if (item.Description.Length > 0)
            {
                <p style="white-space:pre-wrap">@item.Description</p>
            }
        }
        @if (Model.CanEdit)
        {
            var draft=Model.Draft?.ItemId==item.Id?Model.Draft:null;
            var kind=draft?.Kind??item.Kind;
            var date=draft?.TargetDate??item.TargetDate?.ToString("yyyy-MM-dd",CultureInfo.InvariantCulture);
            var dateType=string.IsNullOrEmpty(date)||DateTime.TryParseExact(date,"yyyy-MM-dd",CultureInfo.InvariantCulture,DateTimeStyles.None,out _)?"date":"text";
            @if(draft is not null && Model.HasConflict){<p class="notice">@Text["Prikazana je aktualna spremljena stavka. Tvoj nacrt ostaje u obrascu."]</p>}
            <form method="post" asp-page-handler="Save" asp-route-projectId="@Model.Project.Id" data-unsaved-draft="@(draft is not null ? "true" : null)">
                <input type="hidden" name="itemId" value="@(draft?.IdValue??item.Id.ToString(CultureInfo.InvariantCulture))">
                <input type="hidden" name="revision" value="@(draft?.Revision??item.Revision.ToString(CultureInfo.InvariantCulture))">
                <div class="grid">
                    <label>@Text["Vrsta"]
                        <select name="kind">
                            @if(kind is not ("version" or "milestone")){<option selected value="@kind">@kind</option>}
                            <option value="version" selected="@(kind == "version")">@Text["Verzija"]</option>
                            <option value="milestone" selected="@(kind == "milestone")">@Text["Prekretnica"]</option>
                        </select>
                    </label>
                    <label>@Text["Naziv"]<input name="name" value="@(draft?.Name??item.Name)" maxlength="100" required></label>
                    <label>@Text["Ciljni datum"]<input type="@dateType" name="targetDate" value="@date"></label>
                </div>
                <label>@Text["Opis"]<textarea name="description" maxlength="1000" rows="3">@("\n"+(draft?.Description??item.Description))</textarea></label>
                <label><input type="checkbox" name="isComplete" value="true" checked="@(draft?.IsComplete??item.IsComplete)"> @Text["Dovršeno"]</label>
                @if(draft is not null && Model.HasConflict)
                {
                    <input type="hidden" name="reviewedRevision" value="@item.Revision">
                    <label><input type="checkbox" name="resolveConflict" value="true" required> @Text["Pregledao sam aktualnu verziju i želim spremiti ovaj nacrt umjesto nje."]</label>
                }
                <button>@(item.Id == 0 ? Text["Dodaj"].Value : Text["Spremi izmjene"].Value)</button>
            </form>
        }
    </section>
}
