@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<UiText> Text
@model TeamManager.Web.Pages.IssueFieldsModel
<p><a asp-page="/Project" asp-route-id="@Model.Project.Id">@Model.Project.Input.Name</a></p>
<h1>@Text["Polja zadataka"]</h1>
<div asp-validation-summary="All"></div>

@if (Model.Project.Input.State == "Active")
{
    <section class="card">
        <h2>@Text["Novo tekstualno polje"]</h2>
        <form method="post" asp-page-handler="Create" asp-route-projectId="@Model.Project.Id">
            <label>@Text["Naziv"]<input name="name" maxlength="100" required></label>
            <label><input type="checkbox" name="managersOnly" value="true"> @Text["Samo upravitelji projekta"]</label>
            <button>@Text["Dodaj polje"]</button>
        </form>
    </section>
}

@if (Model.Fields.Count == 0)
{
    <p>@Text["Projekt još nema prilagodljivih polja zadataka."]</p>
}
else
{
    <ul class="card">
        @foreach (var field in Model.Fields)
        {
            <li class="actions">
                <span>@field.Name · @Text[field.ManagersOnly ? "Samo upravitelji projekta" : "Svi s pristupom zadatku"]</span>
                @if (Model.Project.Input.State == "Active")
                {
                    <form method="post" asp-page-handler="Visibility" asp-route-projectId="@Model.Project.Id" asp-route-fieldId="@field.Id">
                        <button name="managersOnly" value="@(field.ManagersOnly ? "false" : "true")">
                            @Text[field.ManagersOnly ? "Prikaži svima s pristupom" : "Ograniči na upravitelje"]
                        </button>
                    </form>
                }
            </li>
        }
    </ul>
}
